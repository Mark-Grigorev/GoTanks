ARG GO_VERSION=1.26.3
ARG ALPINE_VERSION=3.22
ARG VERSION=dev
ARG PORT=8080

FROM golang:${GO_VERSION}-alpine${ALPINE_VERSION} AS build

ARG VERSION

WORKDIR /app

RUN apk add --no-cache gcc libc-dev

COPY go.mod go.sum ./
RUN go mod download

COPY . .
# Ensure tanks-sprites dir exists even if not provided (gitignored external assets)
RUN mkdir -p /app/tanks-sprites
RUN go build -a -installsuffix cgo -o app -ldflags "-X 'main.version=${VERSION}'" ./cmd/server/

FROM alpine:${ALPINE_VERSION}
ARG PORT

RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app

COPY --from=build --chown=appuser:appgroup /app/app           /app/
COPY --from=build --chown=appuser:appgroup /app/tanks         /app/tanks
COPY --from=build --chown=appuser:appgroup /app/maps          /app/maps
COPY --from=build --chown=appuser:appgroup /app/web           /app/web
COPY --from=build --chown=appuser:appgroup /app/tanks-sprites /app/tanks-sprites

USER appuser

EXPOSE ${PORT}

CMD ["/app/app"]